#!/usr/bin/env bash

# SketchyBar Configuration for AeroSpace & macOS Dark Mode

# Color Palette (Catppuccin Mocha / Dark Minimal)
BLACK=0xff181825
WHITE=0xffcdd6f4
PURPLE=0xffcba6f7
CYAN=0xff89dceb
GREEN=0xffa6e3a1
RED=0xfff38ba8
BAR_COLOR=0xff1e1e2e
ITEM_BG_COLOR=0xff313244

sketchybar --bar \
  height=32 \
  color=$BAR_COLOR \
  position=top \
  display=all \
  sticky=on \
  topmost=on \
  padding_left=10 \
  padding_right=10 \
  corner_radius=0

# Default properties for all items
sketchybar --default \
  icon.font="IosevkaTerm Nerd Font:Bold:14.0" \
  label.font="Inter:SemiBold:12.0" \
  icon.color=$CYAN \
  label.color=$WHITE \
  background.color=$ITEM_BG_COLOR \
  background.corner_radius=6 \
  background.height=24 \
  padding_left=4 \
  padding_right=4

##### LEFT ITEMS #####

# Logo / Brand
sketchybar --add item logo left \
  --set logo \
    icon="❄️" \
    label.drawing=off \
    background.drawing=off \
    click_script="nara stats"

# Active Window Title
sketchybar --add item title left \
  --set title \
    script="sketchybar --set \$NAME label=\"\$(lsappinfo info -only name \$(lsappinfo front) | cut -d'\"' -f4)\"" \
    associated_space=all \
    icon.drawing=off \
    label.color=$PURPLE \
    padding_left=8
sketchybar --add event window_focus
sketchybar --subscribe title window_focus front_app_switched

##### RIGHT ITEMS #####

# Clock & Date
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon="🕒" \
    script="sketchybar --set \$NAME label=\"\$(date '+%a %b %d  %I:%M %p')\""

# Battery Indicator
sketchybar --add item battery right \
  --set battery \
    update_freq=30 \
    script="sketchybar --set \$NAME label=\"\$(pmset -g batt | grep -o '[0-9]*%' | head -n1)\"" \
    icon="🔋"

# Volume Indicator
sketchybar --add item volume right \
  --set volume \
    update_freq=5 \
    script="sketchybar --set \$NAME label=\"\$(osascript -e 'output volume of (get volume settings)')%\"" \
    icon="🔊"

sketchybar --update
